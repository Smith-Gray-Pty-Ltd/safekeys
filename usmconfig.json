{
  "$schema": "https://usm.dev/schema/usmconfig-v1.json",
  "version": "1",
  "name": "safekeys",
  "sources": {
    "root": ".",
    "include": [
      "apps/*",
      "packages/*"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.next/**",
      "**/build/**"
    ],
    "package_manifests": [
      "**/package.json"
    ],
    "code_globs": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js"
    ]
  },
  "shared": [],
  "services": [],
  "data": [],
  "outputs": {
    "usm_source": ".usm/",
    "openapi": "docs/api/",
    "tests": "tests/auto-generated/",
    "agents_md": "AGENTS.md"
  },
  "generation": {
    "merge_with_existing": "smart",
    "preserve_comments": true,
    "format": "github-flavored-markdown"
  }
}