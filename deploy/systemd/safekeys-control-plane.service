# Safekeys Control Plane — systemd unit.
#
# The authority service: token issue/revoke, policy, audit. It holds the token
# signing key, so it belongs on the authority host, never on a host that runs
# agent workloads. It never accepts or returns plaintext.
#
# Install:
#   install -m 0644 deploy/systemd/safekeys-control-plane.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now safekeys-control-plane
#
# Verify the confinement:
#   systemd-analyze security safekeys-control-plane

[Unit]
StartLimitIntervalSec=120
StartLimitBurst=5
Description=Safekeys Control Plane API
Documentation=https://github.com/Smith-Gray-Pty-Ltd/safekeys
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple

# The authority binary. Credentials arrive as files via %d, never on argv.
ExecStart=/usr/local/bin/safekeys-cp

User=safekeys-control-plane
Group=safekeys-control-plane

# ── Configuration ───────────────────────────────────────────────────────────
# The signing key and the client API key are delivered as credential files, not
# environment variables. The key is the most sensitive material on this host:
# whoever holds it can mint tokens, so it must not be readable from
# /proc/<pid>/environ or inherited by any child process.
Environment=SAFEKEYS_PROFILE=production
Environment=SAFEKEYS_ADDR=:8080
Environment=SAFEKEYS_ISSUER=https://cp.safekeys.internal
Environment=SAFEKEYS_KID=prod-key-1
# DATABASE_URL carries a password, so it is a credential too.
Environment=DATABASE_URL_FILE=%d/database-url
Environment=SAFEKEYS_DEV_SIGNING_KEY_FILE=%d/signing-key
Environment=SAFEKEYS_API_KEY_FILE=%d/api-key

LoadCredential=database-url:/etc/safekeys/secrets/database-url
LoadCredential=signing-key:/etc/safekeys/secrets/signing-key
LoadCredential=api-key:/etc/safekeys/secrets/api-key

Restart=on-failure
RestartSec=5s

# ── Confinement ─────────────────────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
PrivateIPC=yes

# The control plane listens on a TCP port and dials Postgres and the key store.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=

SystemCallFilter=~@clock @cpu-emulation @debug @keyring @module @mount @obsolete @privileged @raw-io @reboot @resources @swap @sync
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
