# Safekeys production deployment — environment file.
#
# Copy to deploy/.env and fill in. deploy/.env is git-ignored; this example is
# tracked. Nothing here is a secret — credentials live in deploy/secrets/ as
# files, never in this file.
#
#   cp deploy/.env.example deploy/.env

# ── Image pinning ───────────────────────────────────────────────────────────
# REQUIRED for production: reference each image by immutable digest, not a tag.
# A tag can be repointed between your test and your deploy; a digest cannot.
# Get the digest after a build or pull with:
#
#   docker inspect --format='{{index .RepoDigests 0}}' <image>
#
# Or from the registry:
#
#   docker buildx imagetools inspect <image> --format '{{json .Manifest.Digest}}'
#
# The values below are the digests verified when this deployment was written.
# Replace them with the digests of the images you actually built.

# Safekeys images — built from this repository (see Makefile: make images).
SAFEKEYS_CONTROL_PLANE_IMAGE=safekeys-control-plane@sha256:REPLACE_WITH_BUILT_DIGEST
SAFEKEYS_SIDECAR_IMAGE=safekeys-sidecar@sha256:REPLACE_WITH_BUILT_DIGEST

# Third-party images — pinned to the digests verified on 2026-09-26.
SAFEKEYS_POSTGRES_IMAGE=postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
SAFEKEYS_OPENBAO_IMAGE=openbao/openbao:2.7.0@sha256:71156a1c6623a5fa3f5e61b0c6a8ead0faf0df29a778339188443551995d1315

# ── Authority identity ──────────────────────────────────────────────────────
# The issuer URL embedded in every token. MUST be https, and MUST be the URL
# clients actually reach the control plane on — the sidecar verifies tokens
# against the audience/issuer pair.
SAFEKEYS_ISSUER=https://cp.safekeys.internal

# The signing key id. Must correspond to the public key the control plane
# publishes, so sidecars can select the right one during rotation.
SAFEKEYS_KID=prod-key-1

# The audience the sidecar resolves for. Tokens bound to a different audience
# are refused, which is how one environment's token cannot be replayed in
# another.
SAFEKEYS_AUDIENCE=env-prod

# ── Socket sharing (all-container topology only) ────────────────────────────
# The numeric GID of the group granted connect access to the sidecar socket.
# It must match the group agent processes are added to. The distroless sidecar
# image runs as gid 65532, which is why that is the default.
SAFEKEYS_SOCKET_GID=65532
